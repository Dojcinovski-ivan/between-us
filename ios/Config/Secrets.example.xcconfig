// Copy to Secrets.xcconfig (git ignores it) and fill in from the website's
// .env.local: NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY.
// Only ever the anon key here. The service role key must never ship in the app.
// Write `https:/$()/` instead of `https://` or xcconfig cuts the line at `//`.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
